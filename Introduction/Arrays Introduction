#include <iostream>
#include <vector>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<int> a(n);
    for (int &x : a) cin >> x;

    for (int i = n - 1; i >= 0; --i)
        cout << a[i] << (i ? " " : "\n");

    return 0;
}
