#include <iostream>
using namespace std;

int main() {
    int a, b;
    cin >> a >> b;

    const char* words[] = {
        "one", "two", "three", "four", "five",
        "six", "seven", "eight", "nine"
    };

    for (int n = a; n <= b; ++n) {
        if (n >= 1 && n <= 9)
            cout << words[n - 1] << '\n';
        else if (n % 2 == 0)
            cout << "even\n";
        else
            cout << "odd\n";
    }

    return 0;
}
