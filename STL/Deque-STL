#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        int n, k;
        cin >> n >> k;

        vector<int> a(n);
        for (int &x : a) cin >> x;

        deque<int> dq;

        for (int i = 0; i < n; ++i) {
            while (!dq.empty() && a[dq.back()] <= a[i])
                dq.pop_back();

            dq.push_back(i);

            if (dq.front() <= i - k)
                dq.pop_front();

            if (i >= k - 1)
                cout << a[dq.front()] << (i == n - 1 ? '\n' : ' ');
        }
    }

    return 0;
}
