#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<int> v(n);
    for (int &x : v) cin >> x;

    int q;
    cin >> q;

    while (q--) {
        int x;
        cin >> x;

        auto it = lower_bound(v.begin(), v.end(), x);
        int pos = int(it - v.begin()) + 1;

        if (it != v.end() && *it == x)
            cout << "Yes " << pos << '\n';
        else
            cout << "No " << pos << '\n';
    }

    return 0;
}
